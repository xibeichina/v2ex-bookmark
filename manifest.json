{
  "manifest_version": 3,
  "name": "V2EX Bookmark",
  "version": "1.0.0",
  "description": "将 V2EX 收藏帖子增量备份到 Chrome 书签。",
  "permissions": ["bookmarks"],
  "host_permissions": ["*://*.v2ex.com/*"],
  "action": {
    "default_title": "V2EX Bookmark",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/16.png",
    "48": "icons/16.png",
    "128": "icons/16.png"
  }
}
